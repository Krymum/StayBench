{
  "name": "staybench",
  "version": "0.2.1",
  "description": "Open-source sandbox to test AI agents on hotel booking, with injected faults and deterministic grading.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "staybench": "tsx src/cli/index.ts",
    "site:data": "tsx src/cli/index.ts verify results --allow-invalid --out site/src/data/leaderboard.json",
    "site:build": "pnpm site:data && pnpm --filter staybench-site build",
    "site:dev": "pnpm site:data && pnpm --filter staybench-site dev"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "benchmark",
    "hotel",
    "travel",
    "evaluation"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "staybench": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scenarios",
    "README.md",
    "METHODOLOGY.md",
    "LICENSE"
  ]
}
